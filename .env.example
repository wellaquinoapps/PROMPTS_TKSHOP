# Variáveis de Ambiente do Front-end (React / Vite ou Next.js)

# URL da sua instância Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (segura para o browser com RLS ativado)
# NUNCA exponha aqui a SUPABASE_SERVICE_ROLE_KEY!
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

